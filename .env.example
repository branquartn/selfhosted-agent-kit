# ---------------------------------------------------------------------------
# SelfHosted Agent Kit — copy to .env and fill in. Never commit a real .env.
# ---------------------------------------------------------------------------

# --- Model provider (any OpenAI-compatible endpoint) -----------------------
# DeepSeek  : https://api.deepseek.com/v1        model: deepseek-chat
# OpenAI    : https://api.openai.com/v1          model: gpt-4o-mini
# Groq      : https://api.groq.com/openai/v1     model: llama-3.3-70b-versatile
# OpenRouter: https://openrouter.ai/api/v1       model: anthropic/claude-3.5-sonnet
# Ollama    : http://127.0.0.1:11434/v1          model: qwen2.5-coder:14b (LLM_API_KEY can stay empty)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# --- HTTP server -----------------------------------------------------------
AGENT_HOST=127.0.0.1
AGENT_PORT=8800
# Secret required on every /api/ call. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=replace-me-too

# --- Agent behaviour -------------------------------------------------------
AGENT_MAX_STEPS=20
AGENT_CONTEXT_CHARS=120000
AGENT_MAX_TOOL_CHARS=12000
# Leave empty to use the built-in system prompt.
AGENT_SYSTEM_PROMPT=

# --- Storage ---------------------------------------------------------------
# AGENT_ROOT is the base for the defaults below.
# AGENT_ROOT=/opt/agent
# AGENT_DATA_DIR=/opt/agent/var
# AGENT_WORKSPACE=/opt/agent/workspace
# AGENT_WEB_DIR=/opt/agent/web

# --- Tools -----------------------------------------------------------------
AGENT_SHELL_ENABLED=true
# ask  = the web UI asks you before every file write / shell command (recommended)
# auto = the agent runs them straight away
AGENT_APPROVAL=ask
AGENT_APPROVAL_TIMEOUT=300
AGENT_SHELL_TIMEOUT=60
# Optional comma-separated allow-list of executables (empty = anything).
# AGENT_SHELL_ALLOW=git,python3,ls,cat,grep
