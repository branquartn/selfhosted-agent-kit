.PHONY: help run test check install docker clean

help:            ## show this help
	@grep -hE '^[a-z-]+:.*##' $(MAKEFILE_LIST) | sed 's/:.*##/\t/' | column -t -s $$'\t'

run:             ## start the agent (needs .env)
	./run.sh

test:            ## run the pytest suite (no network, no API key)
	python3 -m pytest

check:           ## validate the configuration without starting the server
	PYTHONPATH=src AGENT_ENV_FILE=.env python3 -m agent.server --check

install:         ## create .env, directories and token
	./install.sh

docker:          ## build and start with docker compose
	docker compose up -d --build

clean:           ## remove caches and generated bytecode
	find . -name '__pycache__' -type d -prune -exec rm -rf {} + ; rm -rf .pytest_cache
